{
  "name": "apex-sourcing",
  "private": true,
  "version": "0.1.0",
  "description": "Apex Sourcing B2B import order management platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @apex/domain test",
    "test:integration": "pnpm --filter @apex/api test:integration",
    "migrate": "pnpm --filter @apex/api migrate",
    "migrate:down": "pnpm --filter @apex/api migrate:down",
    "dev": "pnpm --filter @apex/api dev",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
