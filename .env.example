DATABASE_URL=postgres://apex_migrator:CHANGE_ME@127.0.0.1:5432/apex_dev
APP_DATABASE_URL=postgres://app_role:CHANGE_ME@127.0.0.1:5432/apex_dev
# Consumed once by migration 1700000000032_bootstrap-app-role-password.js — sets
# app_role's login password on every migration run (idempotent). Needed on hosts
# with no shell/one-off-job access (e.g. Render's free tier) where the usual
# one-time manual `ALTER ROLE app_role WITH PASSWORD ...` isn't possible. Must
# match the password half of APP_DATABASE_URL above.
APP_ROLE_PASSWORD=CHANGE_ME
JWT_CUSTOMER_SECRET=change-me
JWT_SUPPLIER_SECRET=change-me
JWT_ADMIN_SECRET=change-me
PORT=3000
BIDDING_DEADLINE_MS=259200000
FX_DEVIATION_THRESHOLD_PCT=0.05
ESCALATION_TIMEOUT_MS=259200000
PRODUCTION_SLA_MS=432000000

# Notifications (email + WhatsApp) — all optional. Leave unset and the
# platform still runs correctly: notification_log rows are recorded on every
# transition, just marked SKIPPED_NO_CONFIG instead of actually sent. Fill
# these in with real credentials to activate real sending, no code changes needed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@apex-sourcing.example
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0

# Only used once, by `pnpm --filter @apex/api seed:admin` — bootstraps the
# first ADMIN_OWNER account (idempotent: no-op if any admin already exists).
SEED_ADMIN_EMAIL=owner@apex-sourcing.example
SEED_ADMIN_NAME=Owner
SEED_ADMIN_PASSWORD=CHANGE_ME

# CORS origin allowed to make credentialed browser requests.
FRONTEND_ORIGIN=http://localhost:3001
# Local-disk root for uploaded files (POST /uploads) — no cloud storage credentials available.
UPLOADS_DIR=./uploads

# Which portal origin to embed in a password-reset link — one per actor type,
# since the customer/supplier/admin portals are three separate Next.js apps.
FRONTEND_ORIGIN_CUSTOMER=http://localhost:3001
FRONTEND_ORIGIN_SUPPLIER=http://localhost:3002
FRONTEND_ORIGIN_ADMIN=http://localhost:3003
