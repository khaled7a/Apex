DATABASE_URL=postgres://apex_migrator:CHANGE_ME@127.0.0.1:5432/apex_dev
APP_DATABASE_URL=postgres://app_role:CHANGE_ME@127.0.0.1:5432/apex_dev
JWT_CUSTOMER_SECRET=change-me
JWT_SUPPLIER_SECRET=change-me
JWT_ADMIN_SECRET=change-me
PORT=3000
BIDDING_DEADLINE_MS=259200000
FX_DEVIATION_THRESHOLD_PCT=0.05
ESCALATION_TIMEOUT_MS=259200000
PRODUCTION_SLA_MS=432000000

# Notifications (email + WhatsApp) — all optional. Leave unset and the
# platform still runs correctly: notification_log rows are recorded on every
# transition, just marked SKIPPED_NO_CONFIG instead of actually sent. Fill
# these in with real credentials to activate real sending, no code changes needed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@apex-sourcing.example
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
